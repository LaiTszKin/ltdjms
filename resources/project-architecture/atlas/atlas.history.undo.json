      {
        "slug": "shop-payment",
        "title": "Shop & Payment",
        "story": "成員可在商店瀏覽商品，以貨幣或法幣付款購買，並使用兌換碼兌換商品。管理員可管理商品目錄與產生兌換碼。",
        "dependsOn": [
          "guild-economy"
        ],
        "submodules": [
          {
            "slug": "shop-interaction",
            "kind": "api",
            "role": "商店瀏覽、搜尋、購買流程處理（含按鈕、選單、Modal 互動）",
            "functions": [],
            "variables": [],
