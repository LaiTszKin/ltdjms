{
  "source": "AIChatMentionRoutingDecisionTest.java",
  "routes": ["AGENT_ROUTE", "AI_CHAT_ROUTE", "DENY"],
  "sources": [
    "AGENT_ENABLED",
    "AI_ALLOWLIST",
    "AGENT_CONFIG_UNAVAILABLE",
    "AI_ALLOWLIST_DENIED"
  ],
  "cases": [
    {
      "name": "agent_enabled_priority",
      "agentEnabled": true,
      "restrictionChannelId": "channel-allowed",
      "expectedRoute": "AGENT_ROUTE",
      "expectedSource": "AGENT_ENABLED",
      "skipAllowlistCheck": true
    },
    {
      "name": "agent_disabled_allowlist",
      "agentEnabled": false,
      "restrictionChannelId": "channel-allowed",
      "expectedRoute": "AI_CHAT_ROUTE",
      "expectedSource": "AI_ALLOWLIST"
    },
    {
      "name": "agent_config_unavailable_fail_closed",
      "agentConfigThrows": true,
      "restrictionChannelId": "channel-allowed",
      "expectedRoute": "DENY",
      "expectedSource": "AGENT_CONFIG_UNAVAILABLE",
      "skipAllowlistCheck": true
    },
    {
      "name": "allowlist_denied",
      "agentEnabled": false,
      "restrictionChannelId": "channel-denied",
      "expectedRoute": "DENY",
      "expectedSource": "AI_ALLOWLIST_DENIED"
    }
  ]
}
