{
  "source": "MarkdownValidator.ErrorType, CommonMarkValidatorTest_*, MarkdownAutoFixerTest, DiscordMarkdownPaginatorTest",
  "errorTypes": [
    "MALFORMED_LIST",
    "UNCLOSED_CODE_BLOCK",
    "HEADING_LEVEL_EXCEEDED",
    "HEADING_FORMAT",
    "HEADING_CONTAINS_LIST_MARKER",
    "MALFORMED_NESTED_LIST",
    "MALFORMED_TABLE",
    "ESCAPE_CHARACTER_MISSING",
    "DISCORD_RENDER_ISSUE"
  ],
  "autofixOrder": [
    "fixUnclosedCodeBlocks",
    "fixHeadingLevelExceeded",
    "fixInlineHeadings",
    "fixHeadingFormat",
    "fixHeadingContainsListMarker",
    "fixHeadingInlineListItems",
    "fixEmbeddedLists",
    "fixInlineListMarkersInListLines",
    "fixListFormat",
    "normalizeUnorderedListMarkers",
    "fixNestedListIndentation",
    "fixDiscordUnderlineBold",
    "fixTaskList",
    "fixHorizontalRules"
  ],
  "cases": [
    {
      "name": "heading_format_missing_space",
      "input": "#This is a heading\n##Another heading",
      "expectValidAfterAutofix": true
    },
    {
      "name": "unclosed_code_block",
      "input": "```\nconsole.log('hello');\nSome text after",
      "expectValidAfterAutofix": true
    },
    {
      "name": "discord_spoiler_prefix",
      "input": "reasoning text",
      "streamPrefix": "-# "
    },
    {
      "name": "paginator_respects_limit",
      "maxChunkLength": 1900,
      "preserveCodeBlocks": true
    },
    {
      "name": "table_maps_to_discord_render_issue",
      "input": "| Name | Value |\n| --- | --- |\n| foo | bar |",
      "expectedErrorType": "DISCORD_RENDER_ISSUE"
    },
    {
      "name": "heading_level_exceeded",
      "input": "####### Too deep",
      "expectedErrorType": "HEADING_LEVEL_EXCEEDED"
    },
    {
      "name": "heading_contains_list_marker",
      "input": "# - item in heading",
      "expectedErrorType": "HEADING_CONTAINS_LIST_MARKER"
    },
    {
      "name": "malformed_nested_list",
      "input": "- outer\n   - inner",
      "expectedErrorType": "MALFORMED_NESTED_LIST"
    },
    {
      "name": "discord_render_issue_hr",
      "input": "---",
      "expectedErrorType": "DISCORD_RENDER_ISSUE"
    }
  ]
}
