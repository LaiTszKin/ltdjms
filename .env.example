# ============================================
# LTDJMS — TypeScript Monorepo 環境變數範本
# ============================================
# 複製此檔案為 .env 後填入實際值，或用於開發環境：
#   cp .env.example .env
#
# 系統會依以下優先順序載入設定（高至低）：
#   1. 系統環境變數
#   2. .env 檔案
#   3. 內建預設值

# ----- Discord -----
# Discord Bot Token，從 Discord Developer Portal 取得（必要）
DISCORD_BOT_TOKEN=

# ----- Database -----
# PostgreSQL 連線設定
# 可直接使用 DATABASE_HOST/PORT/NAME/USER/PASSWORD 五項變數（推薦），
# 或使用 DB_URL + DB_USERNAME + DB_PASSWORD 完整 JDBC 方式。
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ltdjms
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# 替代方式（進階）：
# DB_URL=jdbc:postgresql://localhost:5432/ltdjms
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# HikariCP 連線池設定（選填）
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_POOL_CONNECTION_TIMEOUT=30000
# DB_POOL_IDLE_TIMEOUT=600000
# DB_POOL_MAX_LIFETIME=1800000

# ----- Redis -----
# Redis 連線 URI（必要，內建預設值為 redis://localhost:6379）
REDIS_URI=redis://localhost:6379

# ----- AI Service -----
# AI 服務端點與模型設定
# AI_SERVICE_BASE_URL=https://api.openai.com/v1
# AI_SERVICE_API_KEY=sk-...（必要）
# AI_SERVICE_MODEL=gpt-3.5-turbo
# AI_SERVICE_TEMPERATURE=0.7
# AI_SERVICE_TIMEOUT_SECONDS=30

# 外部提示詞檔案目錄（選填）
# PROMPTS_DIR_PATH=./prompts
# PROMPT_MAX_SIZE_BYTES=1048576

# AI 回應行為設定（選填）
# AI_SHOW_REASONING=false
# AI_MARKDOWN_VALIDATION_ENABLED=true
# AI_MARKDOWN_VALIDATION_STREAMING_BYPASS=false

# ----- ECPay -----
# 綠界科技金流設定
# ECPAY_MERCHANT_ID=（必要）
# ECPAY_HASH_KEY=（必要）
# ECPAY_HASH_IV=（必要）
# ECPAY_RETURN_URL=（選填，未設定時由 APP_PUBLIC_BASE_URL + callback path 自動推導）
# ECPAY_STAGE_MODE=true
# ECPAY_CVS_EXPIRE_MINUTES=10080
# ECPAY_CALLBACK_BIND_HOST=127.0.0.1
# ECPAY_CALLBACK_BIND_PORT=8085
# ECPAY_CALLBACK_PATH=/ecpay/callback

# ----- App -----
# 應用程式公開基礎 URL，用於推導 ECPay callback 等網址（選填）
# APP_PUBLIC_BASE_URL=
