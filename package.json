{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"*.{ts,mjs,js,json}\"",
    "lint": "eslint packages/*/src/",
    "dev": "tsx watch packages/shared/src/main.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "prettier": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.0.0"
  }
}
