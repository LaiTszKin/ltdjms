{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc -b && tsc -p apps/bot",
    "test": "vitest run",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"*.{ts,mjs,js,json}\"",
    "lint": "eslint packages/*/src/",
    "dev": "tsx watch apps/bot/src/main.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.8.3",
    "testcontainers": "^12.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
